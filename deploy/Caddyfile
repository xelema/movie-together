{
    # Long-haul links do better on TCP+BBR than on quic-go's NewReno, and the
    # kernel cannot pace QUIC: stay on h1/h2 so BBR applies to every client.
    servers {
        protocols h1 h2
    }
}

{$DOMAIN} {
    # Scripts, styles and playlists only: a 300 ms link pays ~1 MB less on a
    # cold load, and video segments stay byte-exact for Range requests.
    encode zstd gzip {
        match {
            header Content-Type text/*
            header Content-Type application/json*
            header Content-Type application/vnd.apple.mpegurl*
            header Content-Type image/svg+xml*
        }
    }
    reverse_proxy app:3000 {
        flush_interval -1
    }
}

# korean-coach partage ce proxy : le service `korean-coach` est joint au
# reseau movie-together_default (voir son propre compose.yaml).
korean-coach.duckdns.org {
    reverse_proxy korean-coach:51121
}

# draftline partage ce proxy : le service `api` de la stack draftline est joint
# au reseau movie-together_default sous l alias draftline-api.
draftline-xxx.duckdns.org {
    reverse_proxy draftline-api:8080
}
