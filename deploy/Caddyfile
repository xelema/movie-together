{
    # Long-haul links do better on TCP+BBR than on quic-go's NewReno, and the
    # kernel cannot pace QUIC: stay on h1/h2 so BBR applies to every client.
    servers {
        protocols h1 h2
    }
}

{$DOMAIN} {
    reverse_proxy app:3000 {
        flush_interval -1
    }
}

# korean-coach partage ce proxy : le service `korean-coach` est joint au
# reseau movie-together_default (voir xelema/korean-coach, compose.yaml).
korean-coach.duckdns.org {
    reverse_proxy korean-coach:51121
}
