APP_ORIGIN=http://localhost:3000
PORT=3000
DATA_DIR=./data
# Deployment defaults for admin-tunable settings; values saved in /admin win.
MIN_BUFFER_SECONDS=20
LOW_BUFFER_SECONDS=5
ENCODE_THREADS=2
