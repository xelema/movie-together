ADMIN_PASSWORD=replace-with-a-long-random-password
# Dedicated admin accounts, each bound to its language pair.
# ADMIN_PASSWORD stays the fallback for the fr-ko account.
ADMIN_PASSWORD_FR_KO=replace-with-a-long-random-password
ADMIN_PASSWORD_FR_VI=replace-with-a-long-random-password
APP_ORIGIN=http://localhost:3000
PORT=3000
DATA_DIR=./data
# Deployment defaults for admin-tunable settings; values saved in /admin win.
MIN_BUFFER_SECONDS=20
LOW_BUFFER_SECONDS=5
ENCODE_THREADS=2
# LOG_MEDIA=1 writes one journal line per /media request (with its 200/304
# status), which shows whether a browser is serving its bytes from its own
# cache. 0 (default) keeps the media route silent.
LOG_MEDIA=0
# Production with Docker Compose:
# DOMAIN=movies.example.com
# MEDIA_DIR=/mnt/movie-data
# Optional: FFMPEG_PATH and FFPROBE_PATH if binaries are not on PATH.
# Optional: GEMINI_API_KEY or GOOGLE_API_KEY enables voice sessions.
