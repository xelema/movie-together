{
  "name": "movie-night",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:colors": "node --env-file-if-exists=.env scripts/check-colors.js",
    "deploy": "bash deploy/deploy.sh"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "hls.js": "^1.7.2",
    "jschardet": "^3.1.4",
    "plyr": "^3.8.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
